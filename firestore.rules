rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function sameSchool(schoolId) { return signedIn() && profile().schoolId == schoolId; }
    function managesFinance() { return signedIn() && profile().role in ['owner', 'admin']; }
    function manager() { return signedIn() && profile().role in ['owner', 'admin']; }
    function assignedTeacher(data) { return signedIn() && profile().role == 'teacher' && data.teacherId == request.auth.uid; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || profile().role in ['owner', 'admin']);
    }

    match /groups/{groupId} {
      allow read: if sameSchool(resource.data.schoolId) && (manager() || assignedTeacher(resource.data));
      allow create: if sameSchool(request.resource.data.schoolId) && manager();
      allow update: if sameSchool(resource.data.schoolId) && sameSchool(request.resource.data.schoolId) && manager();
      allow delete: if sameSchool(resource.data.schoolId) && manager();
    }

    match /lessons/{lessonId} {
      allow read: if sameSchool(resource.data.schoolId) && (manager() || assignedTeacher(resource.data));
      allow create: if sameSchool(request.resource.data.schoolId) && manager();
      allow update: if sameSchool(resource.data.schoolId) && sameSchool(request.resource.data.schoolId) && (manager() || (assignedTeacher(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homework', 'notes', 'studentRoster', 'studentStatusByDate', 'updatedAt'])));
      allow delete: if sameSchool(resource.data.schoolId) && manager();
    }

    match /payments/{paymentId} {
      allow read: if sameSchool(resource.data.schoolId) && managesFinance();
      allow create: if sameSchool(request.resource.data.schoolId) && managesFinance();
      allow update: if sameSchool(resource.data.schoolId) && sameSchool(request.resource.data.schoolId) && managesFinance();
      allow delete: if sameSchool(resource.data.schoolId) && managesFinance();
    }

    match /students/{studentId} {
      allow read: if sameSchool(resource.data.schoolId) && manager();
      allow create: if sameSchool(request.resource.data.schoolId) && manager();
      allow update: if sameSchool(resource.data.schoolId) && sameSchool(request.resource.data.schoolId) && manager();
      allow delete: if sameSchool(resource.data.schoolId) && manager();
    }

    match /parentAccess/{accessId} {
      allow read: if sameSchool(resource.data.schoolId) && manager();
      allow create: if sameSchool(request.resource.data.schoolId) && manager();
      allow update: if sameSchool(resource.data.schoolId) && sameSchool(request.resource.data.schoolId) && manager();
      allow delete: if sameSchool(resource.data.schoolId) && manager();
    }

    match /parentViews/{token} {
      allow get: if resource.data.active == true;
      allow list: if false;
      allow create: if sameSchool(request.resource.data.schoolId) && manager();
      allow update: if sameSchool(resource.data.schoolId) && manager();
      allow delete: if sameSchool(resource.data.schoolId) && manager();

      match /months/{month} {
        allow get: if get(/databases/$(database)/documents/parentViews/$(token)).data.active == true;
        allow list: if false;
        allow create, update: if manager() && sameSchool(getAfter(/databases/$(database)/documents/parentViews/$(token)).data.schoolId);
        allow delete: if manager() && sameSchool(get(/databases/$(database)/documents/parentViews/$(token)).data.schoolId);
      }
    }
  }
}
